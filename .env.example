# Configuracion del servicio de cuentas.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-account
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3000
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI. Deshabilitada en produccion por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: repositorio en proceso, suficiente para desarrollo y pruebas.
# postgres: requiere ADR-005 aprobado y DATABASE_URL informado.
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# --- Identidad ------------------------------------------------------------
# No existe proveedor de identidad autorizado. El servicio opera con
# FakeIdentityProvider y no almacena contrasenas propias. Vease ADR-004.
