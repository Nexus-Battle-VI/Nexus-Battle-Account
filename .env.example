# Configuracion del servicio de cuentas.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-account
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3000
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI. Deshabilitada en produccion por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: repositorio en proceso. EL ESTADO SE PIERDE AL REINICIAR.
# postgres: adaptador real sobre Kysely (ADR-012). Exige DATABASE_URL.
#
# El esquema NO se migra al arrancar el servicio: migrar desde el arranque hace
# que varias replicas migren a la vez y que una migracion rota deje el servicio
# en bucle de reinicio. Es un paso explicito del despliegue:
#
#   npm run migrate
#
# Receta local HU-01 (PostgreSQL en esta maquina, sin AWS):
#   docker compose up -d
#   PERSISTENCE_DRIVER=postgres
#   DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5433/nexus_battle_account
#   npm run migrate:dev
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5433/nexus_battle_account

# --- Identidad ------------------------------------------------------------
# El servicio NO almacena contrasenas propias. Vease ADR-004.
#
# El alta del sujeto sigue operando con FakeIdentityProvider: el adaptador de
# Cognito para ese puerto es trabajo pendiente.

# --- Autenticacion --------------------------------------------------------
# disabled: ninguna ruta comprueba quien realiza la peticion. Es el estado que
#           describe el BLOCKER de ADR-004, no una opcion de conveniencia.
# jwt:      se exige un testimonio firmado por el user pool de Cognito.
#
# Con NODE_ENV=production, "disabled" IMPIDE ARRANCAR el servicio. Un aviso en
# el registro se pasa por alto; un arranque que falla, no.
AUTH_MODE=disabled

# Obligatorios cuando AUTH_MODE=jwt. Los emite Terraform como salidas del
# modulo `identity` en Nexus-Battle-Infrastructure.
# Ninguno de los dos es un secreto: el identificador del cliente publico viaja
# en la URL de inicio de sesion.
#
# Los valores de abajo son los REALES del entorno ya aprovisionado
# (`infra/envs/prod` de Nexus-Battle-Infrastructure). Estan aqui porque no son
# secretos, y porque con ellos informados activar la verificacion de identidad
# es cambiar una sola variable: AUTH_MODE a `jwt`.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# fake:    FakeAuthenticationProvider. No verifica ninguna contrasena real.
#          Es el unico valor valido en test, y el que usa este ejemplo.
# cognito: CognitoAuthenticationProvider. Verifica contrasena y segundo
#          factor contra el pool real (COGNITO_USER_POOL_ID/CLIENT_ID arriba).
#
# Con NODE_ENV=production, "fake" IMPIDE ARRANCAR el servicio: aceptaria
# cualquier cuenta sembrada en memoria como si fuera real.
#
# "cognito" usa AdminInitiateAuth/AdminRespondToAuthChallenge
# (ADMIN_USER_PASSWORD_AUTH), no las variantes publicas: el cliente de app de
# Cognito es el mismo cliente PUBLICO que usa Web (authorization code grant +
# PKCE, ADR-004), y habilitar el flujo publico ahi dejaria a cualquiera con el
# Client ID autenticar directo, saltandose LoginAccount y el fail-closed de
# ADMINISTRATOR/SUPER_ADMINISTRATOR.
#
# BLOCKERS conocidos (ver docs/architecture.md), ninguno confirmado en
# ADR-004:
#   1. El rol IAM del runtime necesita cognito-idp:AdminInitiateAuth y
#      cognito-idp:AdminRespondToAuthChallenge, acotados al ARN del pool.
#   2. El cliente de Terraform necesita ALLOW_ADMIN_USER_PASSWORD_AUTH en
#      ExplicitAuthFlows.
# Sin ambos, "cognito" falla con AuthenticationProviderError al iniciar
# sesion, no con credenciales invalidas. El adaptador nunca usa claves de AWS
# de larga duracion: se apoya en la cadena de credenciales por defecto del
# SDK (rol de tarea/instancia en AWS real).
AUTHENTICATION_DRIVER=fake

# --- Avatar (HU-01) -------------------------------------------------------
# Ruta relativa o absoluta. No hardcodear una ruta de maquina.
# En local los bytes viven aqui; en AWS se sustituye el adaptador, no el dominio.
AVATAR_STORAGE_PATH=./data/avatars

# --- CORS -----------------------------------------------------------------
# Origenes del frontend, separados por comas. En local apunta a Vite.
# Vacio en produccion (salvo lista explicita). No usar "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Notificaciones (solo local) ------------------------------------------
# Si esta vacio, Account solo registra la solicitud.
# Con Notifications en esta maquina: POST /dev/enqueue del worker.
NOTIFICATIONS_INGEST_URL=

# --- Politica de Privacidad aplicable (EN-011, CA-02) ----------------------
# Version que el registro acepta HOY. VACIO = ninguna version es aplicable, y
# todo registro se rechaza con 400 -es el valor correcto en produccion mientras
# privacy-policy-v0.3.md en Infrastructure siga marcado "Review Candidate /
# Pending Internal Approval": que el documento exista no activa nada por si
# solo, alguien tiene que fijar esta variable a proposito el dia que exista
# aprobacion formal. "v0.3" sirve para desarrollo y pruebas del mecanismo,
# nunca como afirmacion de que v0.3 es la politica legal vigente.
PRIVACY_POLICY_APPLICABLE_VERSION=v0.3
