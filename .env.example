# Configuracion del servicio de cuentas.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-account
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3000
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI. Deshabilitada en produccion por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: repositorio en proceso. EL ESTADO SE PIERDE AL REINICIAR.
# postgres: adaptador real sobre Kysely (ADR-012). Exige DATABASE_URL.
#
# El esquema NO se migra al arrancar el servicio: migrar desde el arranque hace
# que varias replicas migren a la vez y que una migracion rota deje el servicio
# en bucle de reinicio. Es un paso explicito del despliegue:
#
#   npm run migrate
#
# Receta local HU-01 (PostgreSQL en esta maquina, sin AWS):
#   docker compose up -d
#   PERSISTENCE_DRIVER=postgres
#   DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5433/nexus_battle_account
#   npm run migrate:dev
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://nexus:nexus@127.0.0.1:5433/nexus_battle_account

# --- Identidad ------------------------------------------------------------
# El servicio NO almacena contrasenas propias. Vease ADR-004.
#
# El alta del sujeto sigue operando con FakeIdentityProvider: el adaptador de
# Cognito para ese puerto es trabajo pendiente.

# --- Autenticacion --------------------------------------------------------
# disabled: ninguna ruta comprueba quien realiza la peticion. Es el estado que
#           describe el BLOCKER de ADR-004, no una opcion de conveniencia.
# jwt:      se exige un testimonio firmado por el user pool de Cognito.
#
# Con NODE_ENV=production, "disabled" IMPIDE ARRANCAR el servicio. Un aviso en
# el registro se pasa por alto; un arranque que falla, no.
AUTH_MODE=disabled

# Obligatorios cuando AUTH_MODE=jwt. Los emite Terraform como salidas del
# modulo `identity` en Nexus-Battle-Infrastructure.
# Ninguno de los dos es un secreto: el identificador del cliente publico viaja
# en la URL de inicio de sesion.
#
# Los valores de abajo son los REALES del entorno ya aprovisionado
# (`infra/envs/prod` de Nexus-Battle-Infrastructure). Estan aqui porque no son
# secretos, y porque con ellos informados activar la verificacion de identidad
# es cambiar una sola variable: AUTH_MODE a `jwt`.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Avatar (HU-01) -------------------------------------------------------
# Ruta relativa o absoluta. No hardcodear una ruta de maquina.
# En local los bytes viven aqui; en AWS se sustituye el adaptador, no el dominio.
AVATAR_STORAGE_PATH=./data/avatars

# --- CORS -----------------------------------------------------------------
# Origenes del frontend, separados por comas. En local apunta a Vite.
# Vacio en produccion (salvo lista explicita). No usar "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
